<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit Profile | SecureSpace</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <nav class="navbar">
    <a class="nav-brand" href="/dashboard">SecureSpace</a>

    <div class="nav-links">
      <a href="/profile">Profile</a>
      <form action="/logout" method="POST">
        <button class="logout-button" type="submit">Log out</button>
      </form>
    </div>
  </nav>

  <main>
    <section class="auth-card fade-in">
      <div class="brand">
        <div class="logo">S</div>
        <div>
          <h1>Edit profile</h1>
          <p>Keep your account information current.</p>
        </div>
      </div>

      <% if (error) { %>
        <div class="alert"><%= error %></div>
      <% } %>

      <form action="/profile/edit" method="POST">
        <label for="name">Full name</label>
        <input id="name" name="name" type="text" value="<%= user.name %>" required />

        <label for="email">Email address</label>
        <input id="email" type="email" value="<%= user.email %>" disabled />

        <label for="bio">Short bio</label>
        <textarea id="bio" name="bio" rows="4" maxlength="300" placeholder="Write something about yourself"><%= user.bio || "" %></textarea>

        <button type="submit">Save changes</button>
      </form>

      <p class="switch-text">
        <a href="/profile">Cancel and return to profile</a>
      </p>
    </section>
  </main>
</body>
</html>